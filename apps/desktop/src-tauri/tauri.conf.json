{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShortForge",
  "version": "0.5.3",
  "identifier": "org.shortforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShortForge",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Création de YouTube Shorts avec IA, en local",
    "category": "Video",
    "copyright": "Licence MIT",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
