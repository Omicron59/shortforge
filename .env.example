# ShortForge - configuration locale
# Application installee : ce fichier est cree tout seul au premier lancement (Assistant → « Ouvrir le
# fichier de reglages »). En developpement : copie-le en `.env`. Il n'est JAMAIS versionne.
# Apres une modification, quitte et relance ShortForge.

# --- Application ---
SHORTFORGE_DATA_DIR=./data
SHORTFORGE_DATABASE_URL=
SHORTFORGE_HOST=127.0.0.1
SHORTFORGE_PORT=8787
SHORTFORGE_LANGUAGE=fr

# --- Services locaux ---
# Laisse tel quel : ShortForge essaie aussi 8000 (Comfy Desktop) et 8188 tout seul.
COMFYUI_URL=http://127.0.0.1:8000
# Dossier supplementaire pour tes propres workflows ComfyUI (format API JSON)
COMFYUI_WORKFLOWS_DIR=
COMFYUI_IMAGE_WORKFLOW=image_default
IMAGE_WIDTH=768
IMAGE_HEIGHT=1344

OLLAMA_URL=http://127.0.0.1:11434
# Modele de texte installe dans Ollama (ex. resultat de `ollama list`)
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.8

# Les cles Ollama Cloud et OpenRouter ne se mettent PAS ici : saisis-les dans Reglages > Intelligence
# artificielle. Elles sont chiffrees, et la cle de chiffrement est gardee par le trousseau du systeme.
# Seulement sur une machine sans trousseau (serveur) : phrase secrete de 16 caracteres minimum.
# SHORTFORGE_SECRET_KEY=
FFMPEG_PATH=ffmpeg

# --- Budget (en dollars US, 0 = aucun appel payant autorise) ---
BUDGET_MAX_PER_SCENE=0.50
BUDGET_MAX_PER_SHORT=2.00
BUDGET_MAX_PER_DAY=5.00
BUDGET_MAX_PER_MONTH=30.00

# --- Fournisseurs video externes (laisser vide si non utilise) ---
GEMINI_API_KEY=
MINIMAX_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
GOOGLE_CLOUD_PROJECT=

# --- Voix off ---
# auto = Piper s'il est pret, sinon la voix du systeme (Windows ou macOS, rien a installer)
TTS_ENGINE=auto
# Piper (voix naturelle gratuite, installee a part) : programme et fichier de voix .onnx
PIPER_PATH=piper
PIPER_VOICE=
# Nom d'une voix du systeme (vide = voix par defaut de la langue)
SYSTEM_VOICE=
# ElevenLabs (payant, optionnel) : sans tarif renseigne, la generation est bloquee
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_COST_PER_1000_CHARS=
# Transcription locale (faster-whisper) : tiny, base, small, medium
WHISPER_MODEL=small
# Note minimale du controle video pour pouvoir publier
QUALITY_MIN_SCORE=7

# --- Tendances, concurrents et statistiques YouTube (lecture seule) ---
YOUTUBE_API_KEY=
TRENDS_REGION=FR

# --- YouTube ---
# La publication est DESACTIVEE par defaut. Meme activee, chaque publication
# exige une validation humaine explicite dans l'interface.
YOUTUBE_PUBLISH_ENABLED=false
YOUTUBE_CLIENT_SECRETS_FILE=
AI_DISCLOSURE_TEXT=Vidéo générée avec l'aide de l'IA.

# --- TikTok et Instagram par Postiz (optionnel) ---
# DESACTIVE par defaut. Sans Postiz, ShortForge prepare la video et le texte : tu publies toi-meme.
SOCIAL_PUBLISH_ENABLED=false
POSTIZ_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
